# Veritabanı bağlantı adresi (Yerel geliştirme için SQLite veya PostgreSQL)
# PostgreSQL örneği: DATABASE_URL="postgresql://kullanici:sifre@localhost:5432/kadastro_db?schema=public"
DATABASE_URL="file:./dev.db"

# Oturum (JWT) imzalama anahtarı (Üretim ortamında en az 32 karakterli rastgele güvenli bir değer kullanın)
# Oluşturmak için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="CHANGE_ME_IN_PRODUCTION_WITH_AT_LEAST_32_CHARS_SECRET_KEY"

# İlk kurulum (seed) sırasında oluşturulacak varsayılan kullanıcı şifreleri
# Üretim ortamında kendi güçlü şifrelerinizi tanımlayın
SEED_MTCHARITA_PASSWORD="ChangeMe_Mtc2026!"
SEED_NILPROJE_PASSWORD="ChangeMe_Nil2026!"
SEED_TKGM_PASSWORD="ChangeMe_Tkgm2026!"
